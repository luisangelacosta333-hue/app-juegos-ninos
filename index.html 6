    btns.forEach(function(b){ var el=document.createElement('button'); el.className='tab-btn'; el.textContent=b.label; el.style.background='linear-gradient(135deg,#475569,#334155)'; el.style.fontSize='16px'; el.style.padding='12px 4px'; if(b.id)el.id=b.id; el.onclick=b.fn; w.appendChild(el); });
  }
  function togglePlay(){ clickSafe(); ensureCtx();
    if(S.paused){ try{speechSynthesis.resume();}catch(e){} S.paused=false; S.playing=true; startMelody(); setPlayIcon('⏸'); return; }
