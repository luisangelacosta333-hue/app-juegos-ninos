      +'<div style="max-width:340px;margin:0 auto;">';
    for(var i=0;i<opts.length;i++){ html+='<button class="tab-opt" data-v="'+opts[i]+'">'+opts[i]+'</button>'; }
    html+='</div><div class="tab-feedback" id="tabFb"></div>';
    stage(html);
    hint('Modo práctica · tabla del '+S.table+' · Tocá el resultado correcto.');
    var fb=$('tabFb');
    var all=document.querySelectorAll('.tab-opt');
    for(var k=0;k<all.length;k++){ (function(btn){ btn.onclick=function(){ var v=Number(btn.getAttribute('data-v'));
      for(var j=0;j<all.length;j++)all[j].disabled=true;
      if(v===r){ P.ok++; btn.classList.add('correct'); if(fb){fb.textContent='¡Muy bien! '+a+' × '+b+' = '+r; fb.style.color='#4ade80';} clickSafe(); spawnNotes(); speak(a+' por '+b+' son '+r, function(){}); }
      else { P.fail++; btn.classList.add('wrong'); if(fb){fb.textContent='Era '+r+'. ¡Seguí intentando!'; fb.style.color='#f87171';} wrongSafe(); var key=a+'x'+b; save.tablas.errors[key]=(save.tablas.errors[key]||0)+1; persistSafe(); for(var j=0;j<all.length;j++){ if(Number(all[j].getAttribute('data-v'))===r)all[j].classList.add('correct'); } }
      P.q++; setTimeout(nextPracticeQ,1400);
    }; })(all[k]); }
  }
  function finishPractice(){ var dom=(P.ok===P.total);
    var html='<div class="tab-op" style="font-size:clamp(24px,7vw,40px);color:#f1f5f9;">¡Práctica terminada!</div>'
      +'<div style="font-size:20px;font-weight:800;margin:10px 0;color:#e2e8f0;">Aciertos: <span style="color:#4ade80;">'+P.ok+'</span> / '+P.total+'</div>';
    var gained=0;
    if(dom && !save.tablas.mastered[S.table]){ save.tablas.mastered[S.table]=true; gained=3; addCoins(5); html+='<div style="color:#facc15;font-weight:800;font-size:17px;">¡Dominaste la tabla del '+S.table+'! +3 ★ +5 monedas</div>'; fanfareSafe(); }
    else if(P.ok>=7){ gained=1; html+='<div style="color:#4ade80;font-weight:700;font-size:15px;">¡Muy bien! +1 ★</div>'; }
    else { html+='<div style="color:#fbbf24;font-weight:700;font-size:15px;">Seguí practicando, ¡vas a mejorar!</div>'; }
    if(gained>0){ addStars(gained); persistSafe(); }
    html+='<div style="margin-top:16px;"><button class="tab-bigbtn" id="tabAgain">Practicar de nuevo</button></div>';
    stage(html); hint('');
    var b=$('tabAgain'); if(b)b.onclick=function(){ clickSafe(); startPractice(); };
    renderTableSel();
  }

  /* ---------- DESAFIO ---------- */
  function renderChallengeIntro(){
    stage('<div class="tab-op" style="font-size:clamp(22px,6vw,38px);color:#facc15;">Modo Desafío</div>'
      +'<div style="font-size:15px;color:#cbd5e1;font-weight:600;max-width:340px;margin:8px auto;">Tenés 60 segundos. Respondé la mayor cantidad de multiplicaciones de la tabla del '+S.table+'. ¡Cada acierto suma 10 puntos!</div>'
      +'<div style="margin-top:18px;"><button class="tab-bigbtn" id="tabStartCh">¡Empezar!</button></div>');
    hint('Récord: '+(save.tablas.bestChallenge||0)+' puntos.');
    var b=$('tabStartCh'); if(b)b.onclick=function(){ clickSafe(); startChallenge(); };
  }
  function startChallenge(){ C={time:60,score:0,ok:0,timer:null}; renderChallengeQ();
    C.timer=setInterval(function(){ C.time--; var bar=$('tabChBar'); if(bar)bar.style.width=Math.max(0,(C.time/60)*100)+'%'; var t=$('tabChTime'); if(t)t.textContent=C.time+'s'; if(C.time<=0){ clearInterval(C.timer); C.timer=null; finishChallenge(); } },1000);
  }
  function renderChallengeQ(){ var b=1+Math.floor(Math.random()*10); var a=S.table; var r=a*b; var opts=opciones(r,a);
    stage('<div class="tab-hud"><span style="color:#facc15;" id="tabChTime">60s</span><span style="color:#22d3ee;">Puntos: <span id="tabChScore">0</span></span><span style="color:#4ade80;" id="tabChOk">Bien: 0</span></div>'
      +'<div class="timer-bar" style="margin-bottom:14px;background:rgba(139,147,194,.25);"><div id="tabChBar" style="height:100%;width:100%;background:linear-gradient(90deg,#facc15,#f97316);transition:width 1s linear;"></div></div>'
      +'<div class="tab-op">'+a+' × '+b+' = ?</div>'
      +'<div style="max-width:340px;margin:0 auto;">'+opts.map(function(o){return '<button class="tab-opt" data-v="'+o+'">'+o+'</button>';}).join('')+'</div>'
      +'<div class="tab-feedback" id="tabFb"></div>');
    hint('¡Rápido! Contra reloj.');
    var all=document.querySelectorAll('.tab-opt');
    for(var k=0;k<all.length;k++){ (function(btn){ btn.onclick=function(){ var v=Number(btn.getAttribute('data-v'));
      if(v===r){ C.ok++; C.score+=10; clickSafe(); spawnNotes(); }
      else { wrongSafe(); var key=a+'x'+b; save.tablas.errors[key]=(save.tablas.errors[key]||0)+1; persistSafe(); }
      var s=$('tabChScore'); if(s)s.textContent=C.score; var o=$('tabChOk'); if(o)o.textContent='Bien: '+C.ok;
      if(C.timer) renderChallengeQ();
    }; })(all[k]); }
  }
  function finishChallenge(){ var record=save.tablas.bestChallenge||0; var isRecord=C.score>record; if(isRecord)save.tablas.bestChallenge=C.score;
    var gained=Math.floor(C.ok/5); if(gained>0)addStars(gained); if(C.ok>=8)addCoins(3); persistSafe(); if(gained>0)fanfareSafe();
    stage('<div class="tab-op" style="font-size:clamp(22px,6vw,38px);color:#f1f5f9;">¡Tiempo!</div>'
      +'<div style="font-size:19px;font-weight:800;margin:8px 0;color:#e2e8f0;">Puntos: <span style="color:#facc15;">'+C.score+'</span> · Aciertos: <span style="color:#4ade80;">'+C.ok+'</span></div>'
      +(isRecord?'<div style="color:#facc15;font-weight:800;font-size:16px;">¡Nuevo récord!</div>':'<div style="color:#94a3b8;font-weight:600;font-size:14px;">Récord: '+record+'</div>')
      +(gained>0?'<div style="color:#4ade80;font-weight:700;">+'+gained+' ★</div>':'')
      +'<div style="margin-top:16px;"><button class="tab-bigbtn" id="tabAgainCh">Otra vez</button></div>');
    hint('');
    var b=$('tabAgainCh'); if(b)b.onclick=function(){ clickSafe(); startChallenge(); };
  }

  /* ---------- REPASO ---------- */
  function startRepaso(){ var keys=Object.keys(save.tablas.errors||{}); var queue=[];
    for(var k=0;k<keys.length;k++){ var c=save.tablas.errors[keys[k]]; if(c>0){ var parts=keys[k].split('x'); var a=Number(parts[0]), bb=Number(parts[1]); for(var i=0;i<Math.min(c,3);i++) queue.push({a:a,b:bb,r:a*bb}); } }
    R={queue:shuffle(queue),idx:0,ok:0,streak:{}};
    if(R.queue.length===0){ stage('<div class="tab-op" style="color:#4ade80;font-size:clamp(22px,6vw,36px);">¡Todo dominado!</div><div style="font-size:15px;color:#cbd5e1;font-weight:600;margin-top:8px;max-width:320px;margin-left:auto;margin-right:auto;">No tenés operaciones para repasar. ¡Felicitaciones!</div>'); hint(''); return; }
    nextRepasoQ();
  }
  function nextRepasoQ(){ if(R.idx>=R.queue.length){ finishRepaso(); return; } var q=R.queue[R.idx]; var opts=opciones(q.r,q.a);
    stage('<div class="tab-hud"><span style="color:#4ade80;">Repaso '+(R.idx+1)+'/'+R.queue.length+'</span><span style="color:#22d3ee;">Bien: '+R.ok+'</span></div>'
      +'<div style="font-size:13px;color:#fbbf24;font-weight:700;margin-bottom:6px;">Esta te costó antes ¡dale con fuerza!</div>'
      +'<div class="tab-op">'+q.a+' × '+q.b+' = ?</div>'
      +'<div style="max-width:340px;margin:0 auto;">'+opts.map(function(o){return '<button class="tab-opt" data-v="'+o+'">'+o+'</button>';}).join('')+'</div>'
      +'<div class="tab-feedback" id="tabFb"></div>');
    hint('Modo repaso · solo operaciones que te costaron.');
    var fb=$('tabFb'); var all=document.querySelectorAll('.tab-opt');
    for(var k=0;k<all.length;k++){ (function(btn){ btn.onclick=function(){ var v=Number(btn.getAttribute('data-v'));
      for(var j=0;j<all.length;j++)all[j].disabled=true;
      var key=q.a+'x'+q.b;
      if(v===q.r){ R.ok++; R.streak[key]=(R.streak[key]||0)+1; btn.classList.add('correct'); if(fb){fb.textContent='¡Sí! '+q.a+' × '+q.b+' = '+q.r; fb.style.color='#4ade80';} clickSafe(); spawnNotes(); if(R.streak[key]>=2){ save.tablas.errors[key]=Math.max(0,(save.tablas.errors[key]||0)-1); persistSafe(); } }
      else { R.streak[key]=0; btn.classList.add('wrong'); if(fb){fb.textContent='Era '+q.r; fb.style.color='#f87171';} wrongSafe(); for(var j=0;j<all.length;j++){ if(Number(all[j].getAttribute('data-v'))===q.r)all[j].classList.add('correct'); } }
      R.idx++; setTimeout(nextRepasoQ,1300);
    }; })(all[k]); }
  }
  function finishRepaso(){ if(R.ok>0){ addStars(1); addCoins(2); persistSafe(); fanfareSafe(); }
    stage('<div class="tab-op" style="font-size:clamp(22px,6vw,36px);color:#f1f5f9;">Repaso terminado</div>'
      +'<div style="font-size:17px;font-weight:700;color:#e2e8f0;margin:8px 0;">Aciertos: <span style="color:#4ade80;">'+R.ok+'</span>'+(R.ok>0?' · +1 ★ +2 monedas':'')+'</div>'
      +'<div style="margin-top:16px;"><button class="tab-bigbtn" id="tabAgainRp">Repasar de nuevo</button></div>');
    hint('');
    var b=$('tabAgainRp'); if(b)b.onclick=function(){ clickSafe(); startRepaso(); };
  }

  /* ---------- eventos ---------- */
  function init(){
    if($('cardTablas')) $('cardTablas').addEventListener('click', openTablas);
    if($('tabBackBtn')) $('tabBackBtn').addEventListener('click', closeTablas);
    var el=$('tabStars'); if(el)el.textContent=save.tablas.stars||0;
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();

</script>
<script>
var BOCETOS_IMG=[
{name:'Auto de carrera',img:'data:image/jpeg;base64,'},
{name:'Princesa',img:'data:image/jpeg;base64,'},
{name:'Unicornio',img:'data:image/jpeg;base64,'},
{name:'Guerrero anime',img:'data:image/jpeg;base64,'},
{name:'Superhéroe',img:'data:image/jpeg;base64,'},
{name:'Mariposa',img:'data:image/jpeg;base64,'}
];/* ============================================================
   MODULO: PINTAR Y COLOREAR v3 (imagenes reales para colorear)
   Sin espejo, sin stickers. Interfaz simple, lienzo 900x700.
   ============================================================ */
(function(){
  if(!window.save) window.save={};
  if(!save.pintura) save.pintura={stars:0, saved:0};
  if(!save.pet) save.pet={coins:0};
  function persistSafe(){try{if(window.persist)persist();}catch(e){}}
  function fanfareSafe(){try{if(window.sndFanfare)sndFanfare();}catch(e){}try{if(window.burstConfetti)burstConfetti(40);}catch(e){}}
  function clickSafe(){try{if(window.sndClick)sndClick();}catch(e){}}
  function stopSpeakSafe(){try{if(window.stopSpeak)stopSpeak();}catch(e){}}
  function $(id){return document.getElementById(id);}

  var css=''
    +'.pin-swatch{width:30px;height:30px;border-radius:50%;border:3px solid #fff;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.3);transition:transform .15s;flex:0 0 auto;}'
    +'.pin-swatch.active{transform:scale(1.25);border-color:#facc15;box-shadow:0 0 12px rgba(250,204,21,.8);}'
    +'.pin-tool{border:none;border-radius:12px;padding:9px 13px;font-weight:700;font-size:12px;cursor:pointer;color:#fff;background:linear-gradient(135deg,#475569,#334155);font-family:inherit;transition:transform .15s;}'
    +'.pin-tool:active{transform:scale(.94);}'
    +'.pin-tool.active{background:linear-gradient(135deg,#8b5cf6,#6d28d9);box-shadow:0 0 12px rgba(139,92,246,.7);}'
    +'.pin-sketch{min-width:86px;height:64px;border-radius:10px;border:2px solid rgba(139,147,194,.4);background:#fff;cursor:pointer;flex:0 0 auto;display:flex;align-items:flex-end;justify-content:center;padding-bottom:2px;font-size:10px;font-weight:700;color:#475569;font-family:inherit;position:relative;overflow:hidden;}'
    +'.pin-sketch.active{border-color:#a78bfa;box-shadow:0 0 12px rgba(167,139,250,.7);}'
    +'.pin-sketch img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}'
    +'.pin-sketch span{position:relative;z-index:1;background:rgba(255,255,255,.92);padding:0 5px;border-radius:6px;}';
  var st=document.createElement('style'); st.textContent=css; document.head.appendChild(st);

  var COLORS=['#ef4444','#f97316','#facc15','#22c55e','#14b8a6','#22d3ee','#3b82f6','#8b5cf6','#ec4899','#a16207','#000000','#ffffff','#94a3b8','#fb923c'];
  var SIZES=[{label:'Fino',v:4},{label:'Medio',v:10},{label:'Grueso',v:24}];

  var state={color:COLORS[0],size:SIZES[1].v,eraser:false,outline:false,sketch:0,drawing:false,last:null,img:null};
  var canvas,ctx;

  function drawSketch(idx){
    state.sketch=idx;
    document.querySelectorAll('.pin-sketch').forEach(function(el,i){el.classList.toggle('active',i===idx);});
    var img=new Image();
    img.onload=function(){
      state.img=img;
      ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,canvas.width,canvas.height);
      ctx.drawImage(img,0,0,canvas.width,canvas.height);
    };
    img.src=BOCETOS_IMG[idx].img;
    $('pinHint').textContent='Dibujo: '+BOCETOS_IMG[idx].name+' · Pintalo como quieras!';
  }

  function renderSel(){
    var w=$('pinSel'); w.innerHTML='';
    BOCETOS_IMG.forEach(function(b,i){
      var el=document.createElement('button'); el.className='pin-sketch'+(i===state.sketch?' active':'');
      var im=document.createElement('img'); im.src=b.img; el.appendChild(im);
      var lbl=document.createElement('span'); lbl.textContent=b.name; el.appendChild(lbl);
      el.onclick=function(){clickSafe(); drawSketch(i);};
      w.appendChild(el);
    });
  }
  function renderPalette(){
    var w=$('pinPalette'); w.innerHTML='';
    COLORS.forEach(function(c){
      var el=document.createElement('button'); el.className='pin-swatch'+(c===state.color && !state.eraser && !state.outline?' active':''); el.style.background=c;
      el.onclick=function(){clickSafe(); state.color=c; state.eraser=false; state.outline=false; renderPalette(); renderTools();};
      w.appendChild(el);
    });
  }
  function renderTools(){
    var w=$('pinTools'); w.innerHTML='';
    SIZES.forEach(function(s){
      var el=document.createElement('button'); el.className='pin-tool'+(state.size===s.v && !state.eraser && !state.outline?' active':''); el.textContent=s.label;
      el.onclick=function(){clickSafe(); state.size=s.v; state.eraser=false; state.outline=false; renderTools();};
      w.appendChild(el);
    });
    var ol=document.createElement('button'); ol.className='pin-tool'+(state.outline?' active':''); ol.textContent='Delineador';
    ol.onclick=function(){clickSafe(); state.outline=true; state.eraser=false; state.color='#1e293b'; state.size=6; renderTools();}; w.appendChild(ol);
    var er=document.createElement('button'); er.className='pin-tool'+(state.eraser?' active':''); er.textContent='Borrador';
    er.onclick=function(){clickSafe(); state.eraser=true; state.outline=false; renderTools();}; w.appendChild(er);
    var cl=document.createElement('button'); cl.className='pin-tool'; cl.textContent='Limpiar'; cl.style.background='linear-gradient(135deg,#ef4444,#b91c1c)';
    cl.onclick=function(){clickSafe(); drawSketch(state.sketch);}; w.appendChild(cl);
    var sv=document.createElement('button'); sv.className='pin-tool'; sv.textContent='Guardar'; sv.style.background='linear-gradient(135deg,#22c55e,#16a34a)';
    sv.onclick=guardar; w.appendChild(sv);
  }

  function pos(e){
    var r=canvas.getBoundingClientRect();
    var x=(e.touches?e.touches[0].clientX:e.clientX)-r.left;
    var y=(e.touches?e.touches[0].clientY:e.clientY)-r.top;
    return {x:x*(canvas.width/r.width), y:y*(canvas.height/r.height)};
  }
  function start(e){ e.preventDefault(); state.drawing=true; state.last=pos(e); move(e); }
  function move(e){
    if(!state.drawing)return; e.preventDefault();
    var p=pos(e);
    ctx.strokeStyle=state.eraser?'#ffffff':state.color;
    ctx.lineWidth=state.eraser?state.size*2.2:state.size;
    ctx.lineCap='round'; ctx.lineJoin='round';
    ctx.beginPath(); ctx.moveTo(state.last.x,state.last.y); ctx.lineTo(p.x,p.y); ctx.stroke();
    state.last=p;
  }
  function end(){ state.drawing=false; }

  function guardar(){
    clickSafe();
    try{
      var a=document.createElement('a'); a.download='mi-dibujo-buggyia.png'; a.href=canvas.toDataURL('image/png'); a.click();
      save.pintura.saved=(save.pintura.saved||0)+1;
      save.pintura.stars=(save.pintura.stars||0)+1;
      save.pet.coins=(save.pet.coins||0)+2;
      persistSafe(); fanfareSafe();
      var el=$('pinStars'); if(el)el.textContent=save.pintura.stars;
      $('pinHint').textContent='¡Obra guardada! +1 estrella +2 monedas. Total: '+save.pintura.saved;
    }catch(err){ $('pinHint').textContent='No se pudo guardar en este navegador.'; }
  }

  function openPintura(){
    stopSpeakSafe(); clickSafe();
    $('homeScreen').classList.add('hidden-screen');
    $('pinturaScreen').classList.remove('hidden-screen');
    var el=$('pinStars'); if(el)el.textContent=save.pintura.stars||0;
    canvas=$('pinCanvas'); ctx=canvas.getContext('2d');
    renderSel(); renderPalette(); renderTools(); drawSketch(0);
    canvas.onmousedown=start; canvas.onmousemove=move; canvas.onmouseup=end; canvas.onmouseleave=end;
    canvas.ontouchstart=start; canvas.ontouchmove=move; canvas.ontouchend=end;
    try{window.scrollTo(0,0);}catch(e){}
  }
  function closePintura(){
    $('pinturaScreen').classList.add('hidden-screen');
    $('homeScreen').classList.remove('hidden-screen');
    try{ renderHome(); }catch(e){} clickSafe();
  }
  function init(){
    if($('cardPintura')) $('cardPintura').addEventListener('click', openPintura);
    if($('pinBackBtn')) $('pinBackBtn').addEventListener('click', closePintura);
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();

</script>
</body>
