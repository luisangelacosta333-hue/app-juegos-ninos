    +'.tab-sub{font-size:13px;color:#94a3b8;font-weight:600;margin-top:6px;}';
  var st=document.createElement('style'); st.textContent=css; document.head.appendChild(st);

  /* ---------- melodia original Web Audio ---------- */
  var PENTA=[523.25,587.33,659.25,783.99,880.00,1046.50];
  var MELO_PAT=[0,2,4,2,5,4,2,1,0,2,4,5,4,2,1,0];
  var meIdx=0;
  function ensureCtx(){ if(!S.actx){ try{ S.actx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} } if(S.actx && S.actx.state==='suspended'){ try{S.actx.resume();}catch(e){} } }
  function playNote(freq,dur,vol,type){ if(!S.actx)return; try{ var t=S.actx.currentTime; var o=S.actx.createOscillator(); var g=S.actx.createGain(); o.type=type||'triangle'; o.frequency.value=freq; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(vol||0.08,t+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+dur); o.connect(g); g.connect(S.actx.destination); o.start(t); o.stop(t+dur+0.05); }catch(e){} }
  function startMelody(){ ensureCtx(); if(S.melodyOn)return; S.melodyOn=true; meIdx=0; S.melodyTimer=setInterval(function(){ if(!S.actx)return; var n=PENTA[MELO_PAT[meIdx%MELO_PAT.length]]; playNote(n,0.28,0.07,'triangle'); if(meIdx%4===0) playNote(n/4,0.5,0.05,'sine'); meIdx++; },280); }
  function stopMelody(){ S.melodyOn=false; if(S.melodyTimer){clearInterval(S.melodyTimer); S.melodyTimer=null;} }

  /* ---------- voz (mas lenta) ---------- */
  var vozEsp=null;
  function elegirVoz(){ try{ var vs=speechSynthesis.getVoices(); for(var i=0;i<vs.length;i++){ if(/es[-_]/i.test(vs[i].lang)){ vozEsp=vs[i]; if(/AR|MX|ES/i.test(vs[i].lang)) break; } } }catch(e){} }
  try{ speechSynthesis.onvoiceschanged=elegirVoz; elegirVoz(); }catch(e){}
  function speak(text,onend){ try{ speechSynthesis.cancel(); var u=new SpeechSynthesisUtterance(text); u.lang='es-AR'; u.rate=0.7; u.pitch=1.35; u.volume=1; if(vozEsp)u.voice=vozEsp; S.utter=u; u.onend=function(){ S.utter=null; if(onend)onend(); }; u.onerror=function(){ S.utter=null; if(onend)onend(); }; speechSynthesis.speak(u); }catch(e){ if(onend)onend(); } }
  function cancelSpeak(){ try{ speechSynthesis.cancel(); }catch(e){} S.utter=null; }

  function buildLines(n){ var L=[]; for(var i=1;i<=10;i++){ L.push({a:n,b:i,r:n*i, say:n+' por '+i+' son '+n*i, op:n+' × '+i}); } return L; }
  function shuffle(a){ for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;} return a; }
  function opciones(r,a){ var set={}; set[r]=1; var cands=[r+a,r-a,r+1,r-1,r+2*a,r-2*a,r+2,r-2,r+3*a]; for(var i=0;i<cands.length && Object.keys(set).length<4;i++){ var c=cands[i]; if(c>0 && c!==r && !set[c]) set[c]=1; } while(Object.keys(set).length<4){ var rr=r+Math.floor(Math.random()*9)-4; if(rr>0 && !set[rr]) set[rr]=1; } return shuffle(Object.keys(set).map(Number)); }

  function addStars(n){ save.tablas.stars=(save.tablas.stars||0)+n; var el=$('tabStars'); if(el)el.textContent=save.tablas.stars||0; }
  function addCoins(n){ save.pet.coins=(save.pet.coins||0)+n; }
  function spawnNotes(){ var wrap=$('tabStage'); if(!wrap)return; var glyphs=['♪','♫','♩']; for(var i=0;i<4;i++){ (function(){ var s=document.createElement('span'); s.className='tab-note'; s.textContent=glyphs[Math.floor(Math.random()*glyphs.length)]; s.style.left=(10+Math.random()*80)+'%'; s.style.top=(50+Math.random()*35)+'%'; s.style.color=['#f472b6','#a78bfa','#22d3ee','#facc15'][Math.floor(Math.random()*4)]; s.style.animationDelay=(Math.random()*0.3)+'s'; wrap.appendChild(s); setTimeout(function(){try{s.remove();}catch(e){}},2500); })(); } }

  /* ---------- selectores ---------- */
  function renderTableSel(){ var w=$('tabTableSel'); if(!w)return; w.innerHTML=''; TABLAS.forEach(function(n){ var b=document.createElement('button'); b.className='tab-table'+(n===S.table?' active':'')+(save.tablas.mastered[n]?' tab-mastered':''); b.textContent=n; b.onclick=function(){ clickSafe(); S.table=n; stopSong(); renderTableSel(); renderStage(); }; w.appendChild(b); }); }
  function renderModeSel(){ var w=$('tabModeSel'); if(!w)return; w.innerHTML=''; MODOS.forEach(function(m){ var b=document.createElement('button'); b.className='tab-btn'; b.textContent=m.label; b.style.background=m.id===S.mode?m.color:'rgba(30,41,59,.8)'; b.style.boxShadow=m.id===S.mode?('0 0 12px '+m.color+'88'):'none'; b.onclick=function(){ clickSafe(); S.mode=m.id; stopSong(); renderModeSel(); renderStage(); }; w.appendChild(b); }); }

  function openTablas(){ stopSpeakSafe(); clickSafe(); $('homeScreen').classList.add('hidden-screen'); $('tablasScreen').classList.remove('hidden-screen'); var el=$('tabStars'); if(el)el.textContent=save.tablas.stars||0; renderTableSel(); renderModeSel(); renderStage(); try{window.scrollTo(0,0);}catch(e){} }
  function closeTablas(){ stopSong(); $('tablasScreen').classList.add('hidden-screen'); $('homeScreen').classList.remove('hidden-screen'); try{ renderHome(); }catch(e){} clickSafe(); }

  function hideControls(){ var c=$('tabControls'); if(c)c.style.display='none'; var p=$('tabProgressWrap'); if(p)p.style.display='none'; }
  function showControls(){ var c=$('tabControls'); if(c)c.style.display='grid'; var p=$('tabProgressWrap'); if(p)p.style.display='block'; }
  function updateProgress(){ var pct=Math.min(100,Math.round((S.line/S.lines.length)*100)); var f=$('tabProgressFill'); if(f)f.style.width=pct+'%'; }
  function setPlayIcon(ic){ var b=$('tabPlayBtn'); if(b)b.textContent=ic; }

  function renderStage(){ try{ stopSong(); hideControls(); var m=S.mode;
    if(m==='cancion'||m==='karaoke'){ renderSongStage(); }
