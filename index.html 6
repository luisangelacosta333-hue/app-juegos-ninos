  function playFromLine(){ if(S.line>=S.lines.length){ finishSong(); return; } var l=S.lines[S.line]; animarLinea(l); speak(l.say, function(){ S.line++; updateProgress(); if(S.playing && !S.paused) playFromLine(); else { S.playing=false; setPlayIcon('▶'); } }); }
  function animarLinea(l){ var op=$('tabOp'); if(op){ op.innerHTML=l.op+' = <span class="tab-res">'+l.r+'</span>'; } spawnNotes();
