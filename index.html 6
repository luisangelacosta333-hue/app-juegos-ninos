}

/* ---------- 6. PONG vs CPU ---------- */
function gPong(c){
  c.innerHTML='<div style="text-align:center;"><div style="font-weight:800;color:#fb923c;margin-bottom:6px;font-size:16px;">Vos <span id="poS1">0</span> - <span id="poS2">0</span> CPU · Primero en 5</div><canvas id="poCv" width="360" height="240" style="background:#070b18;border-radius:14px;max-width:100%;touch-action:none;box-shadow:0 0 20px rgba(251,146,60,.3);"></canvas><div id="poMsg" style="margin:8px 0;color:#c7cdf0;font-size:13px;font-weight:600;">Mové la raqueta izquierda con el dedo/mouse</div><button id="poR" class="btn" style="margin-top:8px;'+btnStyle("linear-gradient(135deg,#fb923c,#ea580c)","#fff")+'">Reiniciar</button></div>';
  var cv=G("poCv"),ctx=cv.getContext("2d"),W=360,H=240,run=true,s1=0,s2=0,over=false;
  var b={x:W/2,y:H/2,vx:3,vy:2},p1={y:H/2-25},p2={y:H/2-25};
  function reset(){b={x:W/2,y:H/2,vx:(Math.random()<.5?-3:3),vy:(Math.random()<.5?-2:2)};p1.y=H/2-25;p2.y=H/2-25;}
  function mv(e){var r=cv.getBoundingClientRect(),t=(e.touches?e.touches[0].clientY:e.clientY)-r.top;p1.y=Math.max(0,Math.min(H-50,t*(H/r.height)-25));}
  cv.addEventListener("touchmove",function(e){e.preventDefault();mv(e);},{passive:false});
  cv.addEventListener("mousemove",mv);
  function loop(){
    if(!run)return;
    if(!over){
      b.x+=b.vx;b.y+=b.vy;
      if(b.y<6||b.y>H-6)b.vy*=-1;
      p2.y+=(b.y-(p2.y+25))*0.08;p2.y=Math.max(0,Math.min(H-50,p2.y));
      if(b.x<16&&b.y>p1.y&&b.y<p1.y+50){b.vx=Math.abs(b.vx)+.3;b.vy+=(b.y-(p1.y+25))*0.08;}
      if(b.x>W-16&&b.y>p2.y&&b.y<p2.y+50){b.vx=-Math.abs(b.vx)-.3;b.vy+=(b.y-(p2.y+25))*0.08;}
      if(b.x<0){s2++;G("poS2").textContent=s2;if(s2>=5){over=true;G("poMsg").innerHTML="😕 Ganó la CPU "+s2+"-"+s1;}else reset();}
      if(b.x>W){s1++;G("poS1").textContent=s1;if(s1>=5){over=true;G("poMsg").innerHTML="🏆 ¡Ganaste "+s1+"-"+s2+"!";}else reset();}
    }
    ctx.fillStyle="#070b18";ctx.fillRect(0,0,W,H);
    ctx.fillStyle="#fb923c";ctx.fillRect(6,p1.y,6,50);
    ctx.fillStyle="#22d3ee";ctx.fillRect(W-12,p2.y,6,50);
    ctx.beginPath();ctx.arc(b.x,b.y,6,0,7);ctx.fillStyle="#fff";ctx.fill();
    requestAnimationFrame(loop);
  }
  G("poR").addEventListener("click",function(){s1=0;s2=0;over=false;G("poS1").textContent="0";G("poS2").textContent="0";G("poMsg").textContent="Mové la raqueta izquierda con el dedo/mouse";reset();});
  reset();loop();
  arcStopFn=function(){run=false;};
}

