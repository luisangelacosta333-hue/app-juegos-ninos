/* ---------- 5. SIMON DICE ---------- */
function gSimon(c){
  var seq=[],pos=0,playing=false,colors=["#ef4444","#4ade80","#22d3ee","#facc15"],sounds=[262,330,392,523];
  c.innerHTML='<div style="text-align:center;"><div id="simMsg" style="margin-bottom:10px;color:#22d3ee;font-weight:800;font-size:15px;">Tocá EMPEZAR</div><div id="simScore" style="margin-bottom:10px;color:#c7cdf0;font-size:14px;font-weight:600;">Ronda: 0 · Récord: <span id="simBest">0</span></div><div style="display:grid;grid-template-columns:120px 120px;gap:10px;justify-content:center;margin-bottom:14px;"><button class="simP btn" data-i="0" style="height:120px;border-radius:20px 60px 20px 60px;border:none;background:#ef4444;opacity:.5;"></button><button class="simP btn" data-i="1" style="height:120px;border-radius:60px 20px 60px 20px;border:none;background:#4ade80;opacity:.5;"></button><button class="simP btn" data-i="2" style="height:120px;border-radius:60px 20px 60px 20px;border:none;background:#22d3ee;opacity:.5;"></button><button class="simP btn" data-i="3" style="height:120px;border-radius:20px 60px 20px 60px;border:none;background:#facc15;opacity:.5;"></button></div><button id="simGo" class="btn" style="'+btnStyle("linear-gradient(135deg,#22d3ee,#0ea5e9)","#0b1026")+'">EMPEZAR</button></div>';
  var pads=c.querySelectorAll(".simP"),timers=[],best=0,ac;
  try{ac=new (window.AudioContext||window.webkitAudioContext)();}catch(e){}
  function beep(f){if(!ac)return;try{var o=ac.createOscillator(),g=ac.createGain();o.frequency.value=f;o.connect(g);g.connect(ac.destination);g.gain.setValueAtTime(.15,ac.currentTime);g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+.25);o.start();o.stop(ac.currentTime+.25);}catch(e){}}
  function flash(i){var p=pads[i];p.style.opacity="1";p.style.boxShadow="0 0 25px "+colors[i];beep(sounds[i]);setTimeout(function(){p.style.opacity=".5";p.style.boxShadow="none";},350);}
  function playSeq(){
    playing=false;pos=0;var i=0;
    function nxt(){if(i>=seq.length){playing=true;G("simMsg").textContent="👇 Tu turno! Repetí la secuencia";return;}flash(seq[i]);i++;timers.push(setTimeout(nxt,600));}
    G("simMsg").textContent="👀 Mirá la secuencia...";
    timers.push(setTimeout(nxt,500));
  }
  function round(){seq.push(Math.floor(Math.random()*4));G("simScore").innerHTML="Ronda: "+seq.length+" · Récord: <span id=\"simBest\">"+best+"</span>";playSeq();}
  pads.forEach(function(p){p.addEventListener("click",function(){
    if(!playing)return;var i=+p.getAttribute("data-i");flash(i);
    if(seq[pos]===i){pos++;if(pos>=seq.length){playing=false;if(seq.length>best)best=seq.length;G("simMsg").textContent="🎉 ¡Bien! Siguiente ronda...";timers.push(setTimeout(round,900));}}
    else{playing=false;G("simMsg").innerHTML="💀 ¡Error! Llegaste a ronda "+seq.length+". Tocá EMPEZAR";seq=[];}
  });});
  G("simGo").addEventListener("click",function(){timers.forEach(clearTimeout);timers=[];seq=[];round();});
